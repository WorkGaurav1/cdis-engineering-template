# Copy to compose/.env (or export these directly) before running
# `docker compose -f compose/compose.yaml up`. Never commit the real
# values — this file documents what's needed, nothing more.

# The public origin the app will actually be reached at, e.g.
# https://cdis.example.duckdns.org — used for the backend's CORS_ORIGIN.
PUBLIC_ORIGIN=http://localhost:8080

DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-per-environment

# Optional initial admin — the only way to get a first admin on a fresh
# install. Read solely by the one-off `migrate` job (never by the running
# backend), on every deploy: creates the account once, or grants admin
# to an existing one; never changes a password afterwards, so once it
# exists you may delete both lines. Leave both unset to skip.
# Password: 8+ characters, same rule as sign-up.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Administrator

# "true" lets anyone create their own (plain "user") account from the
# Register page. Defaults to false in compose.production.yaml. With it
# off, the seeded admin is currently the only way in — there's no
# admin-side "create user" yet.
# ALLOW_SELF_REGISTRATION=false
