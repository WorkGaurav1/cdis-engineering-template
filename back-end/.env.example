NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
# allowPublicKeyRetrieval=true: only needed when connecting over a real
# TCP connection to a MySQL 8 server using caching_sha2_password auth
# (the default) without TLS — e.g. from inside a Docker container.
# Plain host-to-host local dev over a Unix socket doesn't need it, but
# it's harmless to always include. This permits the client to fetch the
# server's RSA public key over the unencrypted connection during auth —
# an acceptable tradeoff on a private Docker network the public internet
# never reaches, not something to carry over an untrusted network without
# also enabling TLS between app and DB.
DATABASE_URL="mysql://cdis:cdis_dev_password@localhost:3308/cdis?allowPublicKeyRetrieval=true"

JWT_ACCESS_SECRET=replace-with-a-long-random-secret-per-environment
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
